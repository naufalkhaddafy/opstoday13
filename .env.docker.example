# =============================================================================
# B-Hero Operations Dashboard — Docker Production Environment
# =============================================================================
# CARA PENGGUNAAN:
# 1. Copy isi file ini ke dalam file bernama `.env.docker`
# 2. Isi nilai yang masih kosong (password, key, dll)
# 3. Jalankan `docker compose up -d` di terminal
# =============================================================================

# -----------------------------------------------------------------------------
# 1. INFORMASI APLIKASI
# -----------------------------------------------------------------------------
APP_NAME=B-Hero
APP_ENV=production
APP_KEY=           # PENTING! Generate dengan menjalankan: docker compose exec app php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 2. PENGATURAN PORT (JALUR AKSES)
# -----------------------------------------------------------------------------
# Pengaturan ini menentukan di port berapa layanan bisa diakses dari luar container.
# Jika port bentrok dengan aplikasi lain di server, silakan ubah angka di sebelah kanan.

APP_PORT=8000                # Akses Website Utama B-Hero (Contoh: http://localhost:8000)
DB_FORWARD_PORT=3306         # Akses Database MySQL dari luar (DBeaver/Navicat)
REDIS_FORWARD_PORT=6379      # Akses Redis dari luar (Redis Desktop Manager)
PMA_PORT=8080                # Akses Web phpMyAdmin (Contoh: http://localhost:8080)

# -----------------------------------------------------------------------------
# 3. PENGATURAN DATABASE (MYSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opstoday13
DB_USERNAME=root
DB_PASSWORD=             # PENTING! Isi password untuk root MySQL. Harus sama persis dengan yang dimasukkan di login phpMyAdmin.

# -----------------------------------------------------------------------------
# 4. PENGATURAN CACHE & ANTRIAN (REDIS)
# -----------------------------------------------------------------------------
# Semua session, cache, dan antrian (queue) diproses oleh Redis agar lebih cepat.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=          # PENTING! Isi password keamanan untuk Redis.
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# 5. PENGATURAN API EKSTERNAL
# -----------------------------------------------------------------------------
# Link dan Token untuk menarik data Fingerprint / Mesin Absen
FINGERPRINT_API_URL=
FINGERPRINT_API_TOKEN=

# Link API Internal (Opsional/Jika ada)
SIHEPI_API_URL=
SIHEPI_VERIFY_SSL=false
SIHEPI_TIMEOUT=15

# Layanan Pengirim Notifikasi WhatsApp (WAHA)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Microsoft Entra ID (SSO)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
AZURE_TENANT_ID=

# -----------------------------------------------------------------------------
# 6. PENGATURAN LAIN-LAIN
# -----------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bhero.app"
MAIL_FROM_NAME="${APP_NAME}"
