# =============================================================================
# B-Hero Operations Dashboard — Docker Production Environment
# =============================================================================
# Copy this file to .env.docker and fill in the values before running:
#   docker compose up -d
# =============================================================================

APP_NAME=B-Hero
APP_ENV=production
APP_KEY=           # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (points to docker-compose mysql service) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opstoday13
DB_USERNAME=root
DB_PASSWORD=             # CHANGE THIS — must match MYSQL_ROOT_PASSWORD in docker-compose

# --- Session / Cache / Queue (all via Redis for performance) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (points to docker-compose redis service) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=          # CHANGE THIS — must match redis command password in docker-compose
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bhero.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- External APIs ---
FINGERPRINT_API_URL=
FINGERPRINT_API_TOKEN=

SIHEPI_API_URL=
SIHEPI_VERIFY_SSL=false
SIHEPI_TIMEOUT=15

WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

VITE_APP_NAME="${APP_NAME}"
