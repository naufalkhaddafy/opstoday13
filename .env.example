# =============================================================================
# B-Hero Operations Dashboard — Local Environment Template
# =============================================================================
# CARA PENGGUNAAN:
# 1. Copy isi file ini ke dalam file bernama `.env`
# 2. Isi nilai yang masih kosong (password, key, dll)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. INFORMASI APLIKASI
# -----------------------------------------------------------------------------
APP_NAME=B-Hero
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar
VITE_APP_NAME="${APP_NAME}"
APP_VERSION=v1.4.0

# -----------------------------------------------------------------------------
# 2. PENGATURAN PORT (JALUR AKSES)
# -----------------------------------------------------------------------------
APP_PORT=8000
DB_FORWARD_PORT=3306
REDIS_FORWARD_PORT=6379
PMA_PORT=8080

# -----------------------------------------------------------------------------
# 3. PENGATURAN DATABASE (MYSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opstoday13
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. PENGATURAN CACHE & ANTRIAN (REDIS)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# 5. PENGATURAN API EKSTERNAL
# -----------------------------------------------------------------------------
# Link dan Token untuk menarik data Fingerprint / Mesin Absen
FINGERPRINT_API_URL=http://localhost:3100/api/absence
FINGERPRINT_API_TOKEN=

# Link API Internal (Opsional/Jika ada)
SIHEPI_API_URL=http://localhost:8089/api/Sihepi
SIHEPI_VERIFY_SSL=false
SIHEPI_TIMEOUT=15

# Layanan Pengirim Notifikasi WhatsApp (WAHA)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# -----------------------------------------------------------------------------
# 6. PENGATURAN LAIN-LAIN
# -----------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

##########################################
#Entra
############################################
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost/auth/microsoft/callback
AZURE_TENANT_ID=

# Microsoft SharePoint Lists
SHAREPOINT_INITIATIVE_SITE_ID=
SHAREPOINT_INITIATIVE_LIST_ID=

# AI Trend
AI_ENGINE_URL=http://localhost:8002
