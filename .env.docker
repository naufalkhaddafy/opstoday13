APP_NAME=B-Hero
APP_ENV=production
APP_KEY=base64:EaeH09XGgFICLRM3Yh9AoK+Pe3Qrzbo849iDF0IhtIo=
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_PORT=8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_FORWARD_PORT=3309
DB_DATABASE=opstoday13
DB_USERNAME=root
DB_PASSWORD=secretpassword123

# --- Session / Cache / Queue ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secretredis123
REDIS_PORT=6379
REDIS_FORWARD_PORT=6380

# --- Mail ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@bhero.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- External APIs ---
FINGERPRINT_API_URL=http://host.docker.internal:8089/api/attendance
SIHEPI_API_URL=http://host.docker.internal:8089/api/Sihepi
SIHEPI_VERIFY_SSL=false
SIHEPI_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
